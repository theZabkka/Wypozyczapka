<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Application.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Application"
    Shell.FlyoutBehavior="Flyout"
    Title="Application">

    <ShellContent
        Title="Rejestracja"
        Route="RegistrationPage"
        ContentTemplate="{DataTemplate local:Views.Registration}"
        Shell.TabBarIsVisible="False" />

    <ShellContent
        Title="Strona główna"
        Route="HomePage"
        ContentTemplate="{DataTemplate local:Pages.HomePage}"
        Shell.TabBarIsVisible="False" />

        <ShellContent
        Title="Wypożyczenia"
        Route="Wypozyczenia"
        ContentTemplate="{DataTemplate local:Pages.Rent}"
        Shell.TabBarIsVisible="False"/>

        <ShellContent
         Title="Ustawienia"
         Route="Settings"
         ContentTemplate="{DataTemplate local:Pages.Settings}"/>



</Shell>
