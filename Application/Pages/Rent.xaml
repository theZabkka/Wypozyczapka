<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Application.Pages.Rent"
             Title="Wypożycz"
             BackgroundColor="white">
    <Grid>

        <!-- Obraz jako tło -->
        <Image Source="tlo.jpg"
               Aspect="AspectFill"
               Opacity="0.3"
               HorizontalOptions="FillAndExpand"
               VerticalOptions="FillAndExpand" />
        
        <VerticalStackLayout Padding="20" Spacing="30"
                         HorizontalOptions="FillAndExpand"
                         VerticalOptions="FillAndExpand">

            <!-- Tytuł -->
            <Label Text="WypożyczApka"
        FontSize="32"
        TextColor="Transparent"
        FontAttributes="Bold"
        HorizontalOptions="Center"
        HorizontalTextAlignment="Center" />

            <!-- Kafle kategorii -->
        <VerticalStackLayout Spacing="20"
                             HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">

            <!-- Książki -->
            <Border Stroke="Black"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 15"
                    BackgroundColor="Transparent"
                    HeightRequest="150"
                    HorizontalOptions="FillAndExpand">

                <Grid>
                    <Image Source="ksionszki.jpg" Aspect="AspectFill" />

                    <Label Text="Książki"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />

                    <Button BackgroundColor="Transparent"
                            Command="{Binding GoToBooksCommand}" />
                </Grid>
            </Border>

            <!-- Sprzęt sportowy -->
            <Border Stroke="Black"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 15"
                    BackgroundColor="Transparent"
                    HeightRequest="150"
                    HorizontalOptions="FillAndExpand">

                <Grid>
                    <Image Source="sprzentsportowy.jpg" Aspect="AspectFill" />

                    <Label Text="Sprzęt sportowy"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />

                    <Button BackgroundColor="Transparent"
                            Command="{Binding GoToSportCommand}" />
                </Grid>
            </Border>

            <!-- Przybory -->
            <Border Stroke="Black"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 15"
                    BackgroundColor="Transparent"
                    HeightRequest="150"
                    HorizontalOptions="FillAndExpand">

                <Grid>
                    <Image Source="przyboryszkolne.jpg" Aspect="AspectFill" />

                    <Label Text="Przybory"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />

                    <Button BackgroundColor="Transparent"
                            Command="{Binding GoToSupplyCommand}" />
                </Grid>
            </Border>

        </VerticalStackLayout>

    </VerticalStackLayout>
        </Grid>
</ContentPage>