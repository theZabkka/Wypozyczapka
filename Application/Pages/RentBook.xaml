<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Application.Pages.RentBook"
    x:Name="RentBookPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:Application.Models"
    Title="Książki"
    BackgroundColor="#F8F8FF">

    <ContentPage.BindingContext>
        <viewmodels:RentBookModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Książki"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <CollectionView ItemsSource="{Binding Books}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="15" Margin="10" CornerRadius="20" BackgroundColor="White" HasShadow="True">
                            <VerticalStackLayout Spacing="10">
                                <Image Source="book_placeholder.png"
                                       HeightRequest="150"
                                       Aspect="AspectFill"
                                       HorizontalOptions="Center" />

                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="18" />
                                <Label Text="{Binding Author}" FontSize="14" TextColor="Gray" />

                                <Button Text="Wypożycz"
                                        BackgroundColor="#EDE6D6"
                                        CornerRadius="15"
                                        Command="{Binding BindingContext.RentBook, Source={x:Reference RentBookPage}}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
