<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Application.Pages.RentSportItem"
             x:Name="RentSportItemPage"
             Title="Sprzęt sportowy"
             Shell.NavBarIsVisible="False">

    <Grid>

        <!-- Pasek nawigacji z ikoną menu i nazwą -->
        <Border BackgroundColor="White"
                HeightRequest="55"
                VerticalOptions="Start"
                HorizontalOptions="Fill"
                ZIndex="1"
                Stroke="LightGray"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,0,0" />
            </Border.StrokeShape>
            <Grid>
                <ImageButton Source="flyoutmenuicon.png"
                             WidthRequest="32"
                             HeightRequest="32"
                             BackgroundColor="Transparent"
                             Clicked="OnMenuClicked"
                             HorizontalOptions="Start"
                             VerticalOptions="Center"
                             ZIndex="1"
                             Margin="5,0"/>
                <Label Text="WypożyczApka"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       FontSize="23"
                      
                       TextColor="#333"
                       ZIndex="2"/>
            </Grid>
        </Border>

        <!-- Tło -->
        <Image Source="background.jpg"
               Aspect="AspectFill"
               Opacity="0.5" />

        <!-- Nagłówek z przyciskiem powrotu i tytułem -->
        <Grid VerticalOptions="Start" Margin="0,70,0,0" ZIndex="2" HeightRequest="40">
            <ImageButton Source="backarrow.png"
                         BackgroundColor="Transparent"
                         WidthRequest="32"
                         HeightRequest="32"
                         Clicked="OnBackClicked"
                         HorizontalOptions="Start"
                         VerticalOptions="Center"
                         Margin="20,0"/>
            <Label Text="Sprzęt sportowy"
                   FontSize="28"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   TextColor="#333" />
        </Grid>

        <!-- Lista sprzętów sportowych -->
        <ScrollView VerticalOptions="FillAndExpand" Margin="0,120,0,0" ZIndex="2">
            <CollectionView ItemsSource="{Binding SportItems}"
                            Margin="20,0,20,20"
                            VerticalOptions="FillAndExpand">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10"
                               Margin="10"
                               CornerRadius="20"
                               BackgroundColor="White"
                               HasShadow="True">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  RowDefinitions="Auto">
                                <Image Grid.Row="0" Grid.Column="0"
                                       Source="{Binding ImageSource}"
                                       HeightRequest="80"
                                       WidthRequest="80"
                                       Aspect="AspectFill"
                                       VerticalOptions="Center"
                                       Margin="0,0,10,0" />

                                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           TextColor="Gray" />
                                </VerticalStackLayout>

                                <Button Grid.Row="0" Grid.Column="2"
                                        Text="Wypożycz"
                                        Padding="0"
                                        FontSize="15"
                                        TextColor="Grey"
                                        BackgroundColor="#EDE6D6"
                                        CornerRadius="10"
                                        Command="{Binding BindingContext.RentSportItemCommand, Source={x:Reference RentSportItemPage}}"
                                        CommandParameter="{Binding .}"
                                        WidthRequest="80"
                                        HeightRequest="80"
                                        Margin="10"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

    </Grid>
</ContentPage>
