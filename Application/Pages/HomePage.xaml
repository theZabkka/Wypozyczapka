<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Application.ViewModels"
             x:Class="Application.Pages.HomePage"
             BackgroundColor="{Binding PageBackgroundColor}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ContentPage.BindingContext>
        <viewModels:SettingsViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <!-- Pasek tytułowy -->
        <Border BackgroundColor="{Binding CardBackgroundColor}"
                HeightRequest="55"
                VerticalOptions="Start"
                HorizontalOptions="Fill"
                ZIndex="1"
                Stroke="{Binding DividerColor}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,0,0" />
            </Border.StrokeShape>
            <Grid>
                <ImageButton Source="flyoutmenuicon.png"
                             WidthRequest="32"
                             HeightRequest="32"
                             BackgroundColor="Transparent"
                             Clicked="OnMenuClicked"
                             HorizontalOptions="Start"
                             VerticalOptions="Center"
                             ZIndex="1"
                             Margin="5,0"/>
                <Label Text="WypożyczApka"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       FontSize="23"
                       TextColor="{Binding TextColor}"
                       ZIndex="2"/>
            </Grid>
        </Border>

        <!-- Treść -->
        <Grid Margin="0,75,0,20" RowDefinitions="Auto,*" ZIndex="3">
            <!-- Górna sekcja -->
            <VerticalStackLayout Spacing="15">
                <!-- Baner: Wypożycz -->
                <Border BackgroundColor="Transparent"
                        StrokeThickness="0"
                        HeightRequest="70"
                        Padding="15"
                        StrokeShape="RoundRectangle 20"
                        Margin="30,0,30,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnWypozyczTapped"/>
                    </Border.GestureRecognizers>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#c0aea2" Offset="0.0" />
                            <GradientStop Color="#ab988c" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.2" Offset="0,2" Radius="10" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*"
                          VerticalOptions="Center">
                        <Image Source="wypozycz.png"
                               WidthRequest="30"
                               HeightRequest="30"
                               VerticalOptions="Center"/>
                        <Label Text="Wypożycz"
                               FontSize="20"
                               HorizontalOptions="Start"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center"
                               Margin="15,0,0,0"
                               Grid.Column="1"/>
                    </Grid>
                </Border>

                <!-- Nagłówek: Aktualności -->
                <BoxView HeightRequest="1" BackgroundColor="{Binding DividerColor}" HorizontalOptions="Fill" />
                <Grid ColumnDefinitions="Auto,*" VerticalOptions="Center" Padding="0,5">
                    <Image Source="news.png"
                           WidthRequest="30"
                           HeightRequest="30"
                           VerticalOptions="Center"
                           Margin="20,0,5,0"/>
                    <Label Text="Aktualności"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{Binding TextColor}"
                           VerticalOptions="Center"
                           Margin="10,0,0,0"
                           Grid.Column="1"/>
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="{Binding DividerColor}" HorizontalOptions="Fill" />
            </VerticalStackLayout>

            <!-- Lista -->
            <CollectionView Grid.Row="1"
                            x:Name="NewsCollectionView"
                            ItemsLayout="VerticalList"
                            VerticalOptions="FillAndExpand"
                            HorizontalOptions="FillAndExpand"
                            BackgroundColor="{Binding PageBackgroundColor}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="0"
                                BackgroundColor="{Binding BindingContext.CardBackgroundColor}"
                                StrokeShape="RoundRectangle 10"
                                Margin="0,5"
                                Padding="10">
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="Auto,*">
                                <Image Source="{Binding ImageSource}"
                                       WidthRequest="100"
                                       HeightRequest="100"
                                       Margin="0,0,10,0"
                                       Aspect="AspectFill"
                                       Grid.RowSpan="2"/>
                                <Label Text="{Binding Title}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{Binding BindingContext.TextColor}"
                                       Margin="0,0,0,5"
                                       Grid.Column="1"/>
                                <Label Text="{Binding Description}"
                                       FontSize="14"
                                       TextColor="{Binding BindingContext.SubTextColor}"
                                       Grid.Column="1"
                                       Grid.Row="1"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
