<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Application.ViewModels"
             x:Class="Application.Pages.Settings"
             BackgroundColor="{Binding BackgroundColor}">

    <ContentPage.BindingContext>
        <viewModels:SettingsViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Motyw aplikacji"
               FontSize="20"
               TextColor="{Binding TextColor}"/>

        <Switch IsToggled="{Binding IsDarkTheme}" />

        <Label Text="{Binding IsDarkTheme, StringFormat='Tryb ciemny: {0}'}"
               TextColor="{Binding TextColor}"/>
    </VerticalStackLayout>
</ContentPage>